{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\main.exe",
                "${workspaceFolder}\\main.cpp",
                "/link",
                "${workspaceFolder}\\lib\\raylibdll.lib",
                "winmm.lib",
                "gdi32.lib",
                "opengl32.lib",
                "shell32.lib",
                "user32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Copy raylib.dll",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Copy-Item -LiteralPath '${workspaceFolder}\\lib\\raylib.dll' -Destination '${workspaceFolder}\\raylib.dll' -Force"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build raylib app",
            "dependsOn": [
                "C/C++: cl.exe build active file",
                "Copy raylib.dll"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}
